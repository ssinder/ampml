# ===== 上游无效残留（Windows 版 venv，白占 1.3G） =====
ampmodel/venv/

# ===== 构建产物 =====
_site/
output/
logs/
help/

# ===== 大体积可再生中间产物 =====
# 说明：以下文件均可由 src/01 与 src/02 重新生成（约 15 分钟），
#       因此不入库，以保持 clone 轻量。
#       上游 78 MB 特征表通过 GitHub Release 资产分发，
#       获取方式见 README「Quick start」与 docs/REPRODUCIBILITY.md。
data/train_data.csv
data/val_data.csv
data/test_data.csv
data/train_data_selected.csv
data/val_data_selected.csv
data/*.npy
rawdata/*.csv

# 上游特征提取的中间产物：全部可由 ampmodel/feature_extraction/ 再生，
# 且与 rawdata/ 中的同名文件重复（MD5 7ce771dc55f1cf66d0dd28f8609c0bcb）。
ampmodel/feature_extraction/features/results/*.csv
ampmodel/feature_extraction/features/results/standardized_features/
ampmodel/feature_extraction/features/results/ifeature/
ampmodel/data_processing/**/*.xlsx

# 旧版 1098 维模型目录：已被 src/ 取代，数值不可继承
ampmodel/model_training/

# SHAP 中间值体积大且可由 src/05 重新生成；归因摘要 JSON 保留
results/shap/shap_values/

# ===== 但以下小体积复现凭证必须入库 =====
# 指标 CSV：README 与报告中所有数值的唯一权威来源
!results/*.csv
!data/selected_features.csv
!data/test_data_selected.csv
!data/sample_id_mapping.csv
!data/feature_names_raw.csv
!data/*metadata.json
!results/training_metadata.json
!results/verification_report.json
!results/negative_sampling_sensitivity*.csv
!results/negative_sampling_sensitivity_meta.json
!results/shap/*.json

# ===== 临时文件 =====
*.log
*.tmp
*.bak
*.ipynb_checkpoints/

# 沙箱/包装层产生的残留：根目录下恰好 8 个字符、无扩展名的随机名文件
# （内容均为 4 字节 "blat"）。用 "?×8" 精确匹配长度，再显式放回唯一的
# 真实 8 字符目录 ampmodel —— 纯字母通配（如 [0-9a-z]{8}）会误伤它。
/????????
!/ampmodel/

# 沙箱探针遗留的临时测试仓库
/t1/

# WorkBuddy 项目记忆目录（工具状态，非交付物）
.workbuddy/

# 沙箱探针遗留的临时探测文件
ampmodel/__ignore_probe__.txt

# test/test_cli.py 早期版本把临时目录建在仓库根留下的残留
/ampml_cli_*/

# 测试用的临时工作目录
/.tmp/

# ===== 本地工作副本（不属于仓库交付物） =====
# 以下内容只存在于本机工作区：上游原始数据库快照、第三方工具源码与 skill 文档、
# 个人提示词文件。远端仓库用 scripts/download_data.py 取数，不需要它们。
# ⚠️ 这些路径下没有任何已入库文件，故可安全整目录排除。
#    ampmodel/data_processing/ 的其余 120 个脚本已入库，因此只排除其中两个子目录。

# 上游原始数据库快照（约 100 MB，可由 scripts/download_data.py 复现）
ampmodel/data/

# 第三方工具源码（dssp / modlamp / iFeature 等上游仓库副本）
ampmodel/docs/

# 上游处理流程的实验性分支产物
ampmodel/data_processing/molecular_test/
ampmodel/data_processing/websearch/

# 第三方 skill 文档（K-Dense Inc.，非本项目原创）
docs/shap/
docs/scikit-learn/

# 个人提示词文件（含本机绝对路径）
/SPEC.md
/figures/SPEC.md

# 上游特征提取目录下的说明文件
/ampmodel/feature_extraction/README.md
/ampmodel/feature_extraction/SPEC.md

# 下载示例资产时落在仓库根的临时副本（正式副本在 examples/）
/examples_example_features.csv
/examples_example_sequences.fasta
